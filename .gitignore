# macOS
.DS_Store

# Godot 4+ specific ignores
.godot/
/android/

# godot-sqlite iOS binaries — 286 MB of xcframeworks, far too large to vendor.
# Install godot-sqlite from its GitHub release if you are exporting to iOS.
addons/godot-sqlite/bin/*.ios.*
addons/godot-sqlite/bin/libgodot-cpp.ios.*

# Bindings generated from your own Tarinoi project's schema — created by
# Tools > Tarinoi: Regenerate Bindings after syncing. Not portable between projects.
bindings/generated/
# The core functions scaffold codegen writes beside them derives from those
# generated classes, so it is just as project-specific. In your own game,
# bindings/impl/ is exactly what you commit.
bindings/impl/

# JetBrains IDEs
/.idea/
