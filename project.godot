; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="tarinoi-godot-quickstart-test"
run/main_scene="res://tarinoi_quickstart.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TarinoiRuntime="*uid://dou8nrdwyavpk"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg", "res://addons/tarinoi/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[tarinoi]

api/path=""
api/token="not set — use Tools > Tarinoi: Set Tarinoi API token…"
